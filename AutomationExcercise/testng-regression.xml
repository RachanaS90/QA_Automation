<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Regression Suite">


	<!-- ✅ Run ONLY regression group -->
    <groups>
		<run>
			<include name="regression" />
		</run>
	</groups>

    <test name="Login Regression Tests">
		<classes>
			<class name="AutomationExcercise.Logintest" />
		</classes>
	</test>
      
      <test name="Home Regression Tests">
		<classes>
			<class name="AutomationExcercise.Hometest" />
		</classes>
	</test>
      
      <test name="Product Regression Tests">
		<classes>
			<class name="AutomationExcercise.Producttest" />
		</classes>
	</test>
      
      <test
		name="Cart Regression Tests">
		<classes>
			<class name="AutomationExcercise.Carttest" />
		</classes>
	</test>

  
</suite>



