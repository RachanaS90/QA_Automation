	public void setFormulaSpecialAlerts(List<FormulaSpecialAlerts> formulaSpecialAlerts) {
		this.formulaSpecialAlerts = formulaSpecialAlerts;
	}
	public List<SpecialCustomer> getSpecialCustomers() {
