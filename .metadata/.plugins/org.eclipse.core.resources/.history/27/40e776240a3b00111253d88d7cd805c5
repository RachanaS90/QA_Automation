	        {"Rachana Sinha", "RachanaNew@gmail.com","test@126","10", "April", "1980", "India", "ACCOUNT CREATED!"},
	        {"John Doe", "john2026@gmail.com","test@202","15", "May", "1990", "USA", "ACCOUNT CREATED!"}
	    };
	}
	
	@DataProvider(name ="existingSignupData")
	public Object[][] existingSignupData(){
		return new Object[][] {
			{"Rachana Sinha","RachanaNew@gmail.com"}
		};
