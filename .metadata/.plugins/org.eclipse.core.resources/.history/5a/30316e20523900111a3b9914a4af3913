package AutomationExcercise;

import org.testng.Assert;
import org.testng.annotations.Test;

public class Producttest extends Logintest{

	Productpage productpage;
	@Test
	public void verifyAllProductsPage()
	{
		verifyLogin();
		productpage = new Productpage(driver);
		String actualtext = productpage.getProductPage();
		Assert.assertTrue(actualtext.contains(expectedproducttext));
	}
	
	@Test
	public void searchProduct()
	{
		verifyAllProductsPage();
		String searchproducttitle = productpage.searchProduct();
		Assert.assertTrue(productpage.verifySearchedResult(expectedsearchproducttitle),
		        "Not all products matched the search term: " + expectedsearchproducttitle);
	}
	
	
	
}
