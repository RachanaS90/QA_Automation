		driver.findElement(By.xpath("//a[@href='https://solutionsbpe.rec.sgdbf.saint-gobain.net/ilabo/bo/ilaboFormula/lists']/child::span")).click();
		if(sites.isSelected() && centrale.isSelected())
		{
