			for(int i=0;i<formulaDropdown.size();i++)
			{
			formulaDropdown.get(i).click();
			List<WebElement> formulas = driver.findElements(By.xpath("//tr"));
		    for(int j=0;j<formulas.size();j++)
		    {
			formulas.get(i).click();
			WebElement rightArrow = driver.findElement(By.xpath("//button[@name='right_move']"));
			if(rightArrow.isEnabled())
			{
				driver.findElement(By.xpath("//button[@name='right_move']")).click();
			}
			
			break;
		    }
			}
		}
	}
	
